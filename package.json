{
  "name": "vrising-knowledge-hub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "clean:generated": "tsx scripts/clean-generated-output.ts",
    "generate:reference": "tsx scripts/build-reference-index.ts",
    "generate:db": "tsx scripts/build-db-index.ts",
    "generate:search": "tsx scripts/build-search-index.ts",
    "validate:data": "tsx scripts/validate-generated-data.ts",
    "verify:artifact": "tsx scripts/verify-pages-artifact.ts",
    "generate:data": "npm run clean:generated && npm run generate:db && npm run generate:reference && npm run generate:search",
    "build": "npm run generate:data && npm run validate:data && vite build && tsx scripts/prepare-pages-fallback.ts",
    "preview": "vite preview",
    "verify": "npx tsc --noEmit && bash scripts/check_shortcode_syntax.sh content && npm run build && npm run verify:artifact"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.1.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^5.4.14"
  }
}
